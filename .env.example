# ===== 志愿领航·高报师 配置模板 =====
#
# 复制为 .env 后填入真实值。
# 所有项均为必填，缺失或为空会在启动时立即报错。
# 已通过 .gitignore 排除真实 .env，请勿提交 .env 本身。

# ---------- DeepSeek LLM ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=chat_app

# ---------- 应用服务 ----------
APP_HOST=0.0.0.0
APP_PORT=8010

# ---------- Milvus 向量库 ----------
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=long_term_memory
# content/gen_path/evidence VARCHAR 上限,影响 schema 与写入截断(留 10 字节 UTF-8 余量)
MILVUS_FIELD_MAX_LEN=4000

# ---------- 百炼 DashScope Embedding ----------
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=qwen3.7-text-embedding
EMBED_DIM=1024

# ---------- 业务默认 / 阈值 ----------
DEFAULT_USER_ID=student_001

# 长期记忆:入库去重相似度阈值 (>此值视为重复,不新增,仅刷新访问)
DEDUP_SIM=0.95
# 工作记忆:每次提问检索的相似度阈值与 Top-K
WORKING_MEM_SIM=0.55
WORKING_MEM_TOPK=3
# 长期记忆快照:新会话/缓存失效时注入
SNAPSHOT_TOPK=20
SNAPSHOT_MAX_CHARS=4000
STALE_DAYS=3
CACHE_INVALID_MINUTES=60

# 会话记忆
SESSION_MEM_MIN_TURNS=3
SESSION_MEM_MIN_TOKENS=15000
RECENT_TURNS_KEEP=3
CONTEXT_LIMIT_TOKENS=16000
COMPRESS_RATIO=0.7

# Auto Dream 后台巡检
DREAM_MIN_PENDING=3
DREAM_IDLE_MINUTES=2
DREAM_INTERVAL_SEC=30

# Prompt 截断长度(给到 LLM 的输入上限)
AUTO_MEMORY_PROMPT_MAX_CHARS=8000
SESSION_MEMORY_PROMPT_MAX_CHARS=12000